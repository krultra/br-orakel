{
  "name": "br-orakel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --import tsx --watch server/index.ts",
    "build": "node --import tsx scripts/build.ts",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc -b --pretty false",
    "import": "node --import tsx scripts/import-dataset.ts",
    "analyze-dataset": "node --import tsx scripts/analyze-hackathon-dataset.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.18.0",
    "@digdir/designsystemet-react": "^1.18.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "duckdb": "^1.4.4",
    "fastify": "^5.4.0",
    "lucide-react": "^0.468.0",
    "openai": "^7.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
