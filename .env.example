NODE_ENV=development
APP_MODE=mock
PORT=3001
HOST=0.0.0.0
# Live er anbefalt for MVP-arbeid; sett mock for reproduserbar demo/CI.
OPPGAVEREGISTERET_MODE=live
OPPGAVEREGISTERET_API=https://data.brreg.no/oppgaveregisteret/api
OPPGAVEREGISTERET_PAGE_SIZE=100
OPPGAVEREGISTERET_TIMEOUT_MS=10000
# Enhetsregisteret: live er anbefalt; sett mock for reproduserbar demo/CI.
ENHETSREGISTERET_MODE=live
ENHETSREGISTERET_API=https://data.brreg.no/enhetsregisteret/api
ENHETSREGISTERET_TIMEOUT_MS=10000
# KI: mock er standard og krever ingen nøkkel. Bruk openai først når nøkkelen
# er lagt inn lokalt/på deploymaskinen, aldri i Git.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Romslige demo-defaults. Konteksten skal senere fylles av retrieval, ikke av
# at hele store datasett sendes til nettleseren eller modellen ukritisk.
OPENAI_MAX_OUTPUT_TOKENS=12000
OPENAI_MAX_CONTEXT_CHARS=1000000
OPENAI_TIMEOUT_MS=60000
# false betyr at OpenAI-svaret ikke lagres for senere API-oppslag.
OPENAI_STORE_RESPONSES=false
# PUBLIC_HOST=rapporteringslos.krultra.no
